		(uuid "35b5e77b-caf4-431f-a188-ea55f5231280")
	)
	(text_box "In simple version MCU can read in terms of 3.3v and this section uses a Resistor Divider\nand reduces the High voltage from a battery pack. MCU read this voltage and\nmultiplies with a specific number (here 11) to get real voltage.\n"
		(exclude_from_sim no)
		(at 182.88 181.61 0)
		(size 130.81 8.3717)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 0 0 0 0)
		)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(italic yes)
			)
			(justify top)
		)
		(uuid "37d2f12a-afcb-4ebd-853a-86b03fa16cba")
	)
	(text_box "This section receives the power directly from the battery. It serves it purpose of Fuseing it \n(protection against shorts) and also uses Mosfet to protect from reverse battery connections\nand provides safe output from FB1 but still its dangerous.\n"
		(exclude_from_sim no)
		(at 34.29 181.61 0)
		(size 130.81 8.3717)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 0 0 0 0)
		)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(italic yes)
			)
			(justify top)
		)
		(uuid "4c848245-0ab0-4b7b-a786-3df17f06279c")
	)
